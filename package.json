{
  "name": "@hitalloazevedo/keyzer",
  "version": "1.1.0",
  "description": "Offline converter between Bitcoin private keys in hex and WIF (Wallet Import Format).",
  "keywords": [
    "bitcoin",
    "wif",
    "private-key",
    "hex",
    "converter",
    "offline",
    "crypto"
  ],
  "type": "module",
  "bin": {
    "keyzer": "dist/cli/index.js"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc",
    "start": "npm run build && node dist/cli/index.js",
    "test": "npm run build && npm run typecheck:web && node --test \"dist/**/*.test.js\"",
    "prepublishOnly": "npm test",
    "build:web": "vite build --config web/vite.config.ts && node scripts/finalize-web.mjs",
    "dev:web": "vite --config web/vite.config.ts",
    "typecheck:web": "tsc -p web/tsconfig.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hitalloazevedo/keyzer.git"
  },
  "author": "hitallo azevedo",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/hitalloazevedo/keyzer/issues"
  },
  "homepage": "https://github.com/hitalloazevedo/keyzer#readme",
  "dependencies": {
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@scure/base": "^2.4.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.8",
    "vite-plugin-singlefile": "^2.3.4"
  }
}
